<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Kurtian</Authors>
    <Company>Kurtian</Company>
    <Product>DeskMux</Product>
    <Description>Keyboard-first sessions and panes for native Windows applications.</Description>
    <Copyright>Copyright © 2026 Kurtian</Copyright>
    <RepositoryUrl>https://github.com/kurtian/DeskMux</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
